# Fit Crush gym software: settings for a self-hosted install (Supabase database).
# Copy this file to .env for a PC install, or enter the same names and values in the
# host's "Environment variables" screen (Hostinger: Node.js app → Settings).
# Never commit the real .env file: it holds the database password.
# Full steps: docs/SETUP.md

# --- Database (Supabase) -------------------------------------------------------------
# Supabase dashboard → your project → Connect → "Session pooler" (works over IPv4).
# Replace [YOUR-PASSWORD] with the database password. If the password has @ # / ? % or
# spaces, URL-encode it (e.g. @ becomes %40), or reset it to letters and numbers only.
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# The connection is encrypted automatically. To also verify Supabase's certificate,
# download it (Database settings → SSL configuration) and give its path or PEM text:
# DATABASE_SSL_CA=/home/u123/fitcrush/prod-ca-2021.crt
# Connections the app keeps open (Supabase's free pooler allows about 15 in total).
DATABASE_POOL_SIZE=5

# Create or update the tables automatically every time the app starts (recommended).
AUTO_MIGRATE=true

# --- Sign-in --------------------------------------------------------------------------
# Email + password sign-in (not Manus).
AUTH_MODE=local
# Signs the login cookies. 32+ random characters; make one with: pnpm fitcrush secret
# Changing it later signs everyone out.
JWT_SECRET=

# First start only: creates the owner's login if it does not exist yet. It never
# overwrites a password, so remove both lines after the owner has signed in.
FIRST_OWNER_NAME=
FIRST_OWNER_EMAIL=
FIRST_OWNER_PASSWORD=

# --- Server ---------------------------------------------------------------------------
NODE_ENV=production
# Most hosts set PORT themselves; leave it unset there.
# PORT=3000
# The public address, used only by `fitcrush check` to test that the site is online.
PUBLIC_URL=https://app.fitcrush.in

# --- Fingerprint machine --------------------------------------------------------------
# India time (+5:30) in minutes. Change only if the machine's clock shows a wrong hour.
ADMS_TIMEZONE=330

# --- Optional: automatic WhatsApp (Meta WhatsApp Business Cloud API, paid per message) --
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=fitcrush_alert
# WHATSAPP_TEMPLATE_LANG=en
